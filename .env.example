# ==============================================================================
# SUPABASE CONFIGURATION
# ==============================================================================

# 1. Supabase Project URL & Anon Public Key (Supabase Dashboard -> Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Optional: Supabase Service Role Key (for secure backend operations)
# SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# 2. Supabase PostgreSQL Connection String (Supabase Dashboard -> Settings -> Database -> Connection string)
# Choose "Transaction" pooler (Port 6543) or "Session" pooler (Port 5432)
DATABASE_URL=postgresql://postgres.your-project-id:your-db-password@aws-0-us-east-1.pooler.supabase.com:6543/postgres?sslmode=require

# ==============================================================================
# AUTH CONFIGURATION (Optional if using Better-Auth)
# ==============================================================================
BETTER_AUTH_SECRET=your-random-32-char-secret-string
BETTER_AUTH_URL=http://localhost:3000
